{
  "name": "stocklab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:kis": "node tools/kis-bridge/dev.ts",
    "dev:bridge": "node tools/kis-bridge/server.ts",
    "build": "next build",
    "prebuild": "npm run check:public",
    "postbuild": "npm run check:public -- --artifacts",
    "prestart": "npm run check:public -- --artifacts",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:perf": "node tools/perf/run.ts",
    "data:sync": "node tools/dart/sync.ts",
    "data:review": "node tools/dart/review.ts",
    "data:publish": "node tools/dart/publish.ts",
    "check:public": "node tools/public/check.ts"
  },
  "dependencies": {
    "@next/env": "16.3.7",
    "lightweight-charts": "5.2.1",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "ws": "8.22.0"
  },
  "type": "module"
}
