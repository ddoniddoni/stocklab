# StockLab 웹 / 로컬 운영 도구용 예제
# 실제 값은 프로젝트 루트 .env.local에 저장. 이 파일에는 비밀 값을 쓰지 않는다.
# 웹 기본 모드는 키 없이 실행된다. data:sync는 이 파일이 아닌 .env.local을 명시적으로 읽는다.

APP_ENV=local
NEXT_PUBLIC_MARKET_MODE=synthetic
NEXT_PUBLIC_FINANCIAL_MODE=fixture
NEXT_PUBLIC_PERSISTENCE_MODE=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_SEED=stocklab-v1

# Supabase 사용 단계에서만 설정. publishable 키는 RLS를 전제로 한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# DART_API_KEY: data:sync의 실제 수집에서만 필요. --dry-run은 키를 읽지 않는다.
# SUPABASE_SECRET_KEY: 후속 공개 캐시 적재용이며 현재 DART 도구는 사용하지 않는다.
# MVP Vercel 공개 환경에는 설정하지 않는다.
DART_API_KEY=
SUPABASE_SECRET_KEY=

# 개인 로컬 한투 연동 때만 사용. 공개 환경에서는 세 값 모두 비운다.
KIS_BRIDGE_HTTP_URL=
NEXT_PUBLIC_KIS_BRIDGE_WS_URL=
KIS_BRIDGE_SHARED_SECRET=

# 한투 APP KEY/SECRET은 이 파일이 아닌 tools/kis-bridge/.env.local에만 둔다.
# dev:kis launcher가 로컬 주소와 필요 시 임시 공유 비밀을 주입하도록 구현한다.
