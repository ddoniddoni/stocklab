# 개인 로컬 중계 전용. tools/kis-bridge/.env.local로 복사한다.
# Vercel/브라우저/공개 저장소에 실제 값을 복사하지 않는다.
APP_ENV=local
KIS_ENV=real
KIS_APP_KEY=
KIS_APP_SECRET=

# 기본값은 공식 최대 한도가 아니라 프로젝트의 보수적인 호출 예산이다.
KIS_REST_RPS=2
KIS_MAX_SUBSCRIPTIONS=10

BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# dev:kis는 매 실행마다 메모리에서 임시 생성해 두 로컬 프로세스에 공유한다.
# dev:bridge를 독립 실행할 때는 웹 설정과 같은 비밀 값을 직접 설정해야 한다.
KIS_BRIDGE_SHARED_SECRET=

# 계좌번호, 주문 비밀번호, 주문/체결통보용 HTS ID는 이 프로젝트에서 받지 않는다.
# P5는 real/KRX, Next 3000/bridge 8787, 위 Host/Origin만 지원한다.
